200 REM ---- 3 SECOND SPLASH: 180 VERA VSYNC EDGES AT ~59.5 HZ ----
210 REM ISR = $C207 (SLOT 2) OR $C407 (SLOT 4); WRITING 1 CLEARS VSYNC.
220 IF S = 2 THEN V = 49671
230 IF S = 4 THEN V = 50183
240 FOR F = 1 TO 180
250 POKE V,1
260 IF (PEEK(V) AND 1) = 0 THEN GOTO 260
270 NEXT F
280 RETURN

700 REM ---- PAGE 3 HELPERS: OPEN/CLOSE STUBS AND OPEN PARAMETER BLOCK ----
710 FOR I = 0 TO 14: READ B: POKE 768 + I,B: NEXT I
720 FOR I = 0 TO 9: READ B: POKE 784 + I,B: NEXT I
730 REM OPEN PARAM BLOCK AT $0330: 3 WORDS, I/O BUFFER $7000.
740 POKE 816,3: POKE 817,64: POKE 818,3: POKE 819,0: POKE 820,112
750 RETURN

900 REM ---- PCM PROBE: READ-ONLY OPEN OF OTHELLO.PCM, THEN CLOSE ----
905 REM TRY THE PACKAGED VOLUME FIRST, THEN THE CURRENT PREFIX.
910 P = 0
915 POKE 832,25
920 FOR I = 1 TO 25: READ B: POKE 832 + I,B: NEXT I
925 GOSUB 1200
930 IF P = 1 THEN RETURN
935 POKE 832,11
940 FOR I = 1 TO 11: READ B: POKE 832 + I,B: NEXT I
945 GOSUB 1200
950 RETURN

1200 REM ---- OPEN ($C8), THEN CLOSE ($CC) WITH THE RETURNED REF ----
1210 POKE 800,0: POKE 801,0: CALL 768
1220 IF PEEK(800) = 0 THEN P = 1
1230 IF PEEK(800) = 0 THEN POKE 808,1: POKE 809,PEEK(821): CALL 784
1250 RETURN

